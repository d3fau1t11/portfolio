{
  "name": "habtemariam-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Software development and cybersecurity portfolio for Habtemariam Chuchu",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "verify": "node scripts/verify-build.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "lucide-react": "1.70.0",
    "motion": "14.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
